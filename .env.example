# ==============================================================================
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 排除，切勿把真实密钥提交到仓库
# 注意：Compose 的 .env 不支持行尾注释，注释必须独占一行
# ==============================================================================

# 对外端口（后端 / 数据库 / 缓存仅绑定 127.0.0.1）
WEB_PORT=80
BACKEND_EXPOSE_PORT=8080
MYSQL_EXPOSE_PORT=3306
REDIS_EXPOSE_PORT=6379

# Spring 配置
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long-2026
JWT_TTL=8h
KNIFE4J_ENABLE=true
CORS_ORIGINS=*

# MySQL
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=inventory
MYSQL_USER=inventory
MYSQL_PASSWORD=inventory123456
# 完整 JDBC URL 覆盖（默认按上面 HOST/PORT/DATABASE 拼接；连 TiDB Cloud 等云库时用此项）
# MYSQL_JDBC_URL=jdbc:mysql://gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/inventory?sslMode=REQUIRED&useUnicode=true&characterEncoding=utf8&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true
MYSQL_MAX_POOL_SIZE=20

# Redis
REDIS_PASSWORD=redis123456
REDIS_DB=0
# 托管 Redis（连接数受限）建议调小并发：REDIS_MAX_ACTIVE=16 / REDIS_MAX_IDLE=8 / REDIS_MIN_IDLE=2
# 走 TLS 的云 Redis（如 Upstash）需 REDIS_SSL=true
REDIS_MAX_ACTIVE=32
REDIS_MAX_IDLE=16
REDIS_MIN_IDLE=4

# 消息通知（可选）
NOTIFY_EMAIL_ENABLED=false
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=change-me
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
